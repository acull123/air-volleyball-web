rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserProfile()
        && (!("active" in currentUserDoc().data) || currentUserDoc().data.active != false)
        ? currentUserDoc().data.role
        : null;
    }

    function isAdmin() {
      return userRole() == "admin";
    }

    function isCoach() {
      return userRole() == "coach";
    }

    function isStaff() {
      return isAdmin() || isCoach();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function preservesLegacyUserIdentityFields() {
      return (!("id" in resource.data) || request.resource.data.id == resource.data.id)
        && (!("authUid" in resource.data) || request.resource.data.authUid == resource.data.authUid);
    }

    function preservesUserRole() {
      return !("role" in resource.data) || request.resource.data.role == resource.data.role;
    }

    function preservesUserActiveState() {
      return !("active" in resource.data) || request.resource.data.active == resource.data.active;
    }

    function currentUserPlayerIds() {
      return hasUserProfile() && ("playerIds" in currentUserDoc().data)
        ? currentUserDoc().data.playerIds
        : [];
    }

    function canAccessChatRoom(room) {
      return isSignedIn()
        && (
          (
            ("participantUserIds" in room)
            && request.auth.uid in room.participantUserIds
          )
          || (
            room.type == "team"
            && ("participantPlayerIds" in room)
            && room.participantPlayerIds.hasAny(currentUserPlayerIds())
          )
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.id == userId
          && request.resource.data.authUid == userId
          && request.resource.data.role in ["parent", "player", "unverifiedCoach"]
        );
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && preservesLegacyUserIdentityFields()
          && preservesUserRole()
          && preservesUserActiveState()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "firstName",
            "lastName",
            "phone",
            "playerIds",
            "updatedAt"
          ])
        );
      allow delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read: if canAccessChatRoom(resource.data) || isStaff();
      allow create: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.type == "direct"
          && request.auth.uid in request.resource.data.participantUserIds
          && request.resource.data.teamId == ""
        );
      allow update: if isStaff()
        || (
          canAccessChatRoom(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "lastMessageText",
            "lastMessageSenderId",
            "lastMessageAt",
            "updatedAt"
          ])
          && request.resource.data.lastMessageSenderId == request.auth.uid
        );
      allow delete: if isStaff();
    }

    match /chatMessages/{messageId} {
      allow read: if canAccessChatRoom(get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data) || isStaff();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.notificationSent == false
        && request.resource.data.keys().hasOnly([
          "id",
          "roomId",
          "senderId",
          "senderName",
          "text",
          "notificationSent",
          "createdAt",
          "updatedAt"
        ])
        && canAccessChatRoom(get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data);
      allow update, delete: if isStaff();
    }

    match /pushTokens/{tokenId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /coaches/{coachId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gymSpaces/{gymSpaceId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumni/{alumniId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if isSignedIn()
        && request.resource.data.playerId in currentUserDoc().data.playerIds;
      allow read: if isStaff()
        || (
          isSignedIn()
          && resource.data.playerId in currentUserDoc().data.playerIds
        );
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.playerId in currentUserDoc().data.playerIds
        );
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (
          isSignedIn()
          && resource.data.playerId in currentUserDoc().data.playerIds
        );
      allow write: if isAdmin();
    }

    match /expenseReports/{expenseReportId} {
      allow create: if (isCoach() || isAdmin())
        && request.resource.data.coachUserId == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if isAdmin()
        || (isCoach() && resource.data.coachUserId == request.auth.uid);
      allow update: if isAdmin()
        || (
          isCoach()
          && resource.data.coachUserId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.coachUserId == resource.data.coachUserId
          && request.resource.data.status == "pending"
        );
      allow delete: if isAdmin();
    }

    match /payTypes/{payTypeId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /conflicts/{conflictId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.playerId in currentUserDoc().data.playerIds;
      allow read: if isStaff()
        || (
          isSignedIn()
          && resource.data.playerId in currentUserDoc().data.playerIds
        );
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
