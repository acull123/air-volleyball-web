{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/events/**",
        "destination": "/events.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
